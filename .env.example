# ==========================================
# NextGen Corporate Backend Environment Config
# ==========================================

# Server Port
PORT=5000

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Security Key (used to query /api/admin/inquiries)
ADMIN_KEY=nextgen-admin-secret-2026

# ==========================================
# Supabase Cloud Database (Multi-Device Sync)
# ==========================================
# Obtain these from your Supabase Dashboard: Project Settings -> API
# Public Anon Key is safe for client-side forms with Row Level Security (RLS) enabled.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Serverless / Backend Supabase Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Optional: SMTP Email Notification Forwarding
# ==========================================
# When configured, queries are automatically emailed to administration in real-time
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=official.nextgenorg@gmail.com
# SMTP_PASS=your-app-password
# NOTIFICATION_EMAIL=official.nextgenorg@gmail.com
